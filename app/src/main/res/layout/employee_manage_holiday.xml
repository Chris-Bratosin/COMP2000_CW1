<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".employee_manage_holiday"
    tools:ignore="VisualLintBounds">

    <CalendarView
        android:id="@+id/holidayCalendar2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/ManageHol_confirmBtn"
        android:layout_width="125dp"
        android:layout_height="50dp"
        android:layout_marginTop="27dp"
        android:backgroundTint="@color/white"
        android:text="@string/reqHol_confrimBtn"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/selectNewEnd" />

    <Button
        android:id="@+id/mHolidaysHomeBtn"
        android:layout_width="125dp"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/white"
        android:text="@string/reqHol_homeBtn"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ManageHol_confirmBtn" />

    <EditText
        android:id="@+id/selectStart"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@color/white"
        android:ems="10"
        android:gravity="center"
        android:hint="@string/select_holiday"
        android:inputType="date"
        android:textColorHint="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/holidayCalendar2"
        tools:ignore="Autofill" />

    <EditText
        android:id="@+id/selectNewStart"
        android:layout_width="202dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@color/white"
        android:ems="10"
        android:gravity="center"
        android:hint="@string/select_new_start_date"
        android:importantForAutofill="no"
        android:inputType="date"
        android:textColorHint="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/selectStart" />

    <EditText
        android:id="@+id/selectNewEnd"
        android:layout_width="202dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@color/white"
        android:ems="10"
        android:gravity="center"
        android:hint="@string/select_new_end_date"
        android:textColorHint="@color/black"
        android:inputType="date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/selectNewStart"
        tools:ignore="Autofill" />


</androidx.constraintlayout.widget.ConstraintLayout>
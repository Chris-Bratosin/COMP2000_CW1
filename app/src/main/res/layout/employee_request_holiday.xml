<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".employee_request_holiday">

    <CalendarView
        android:id="@+id/holidayCalendar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/reqHol_confirmBtn"
        android:layout_width="125dp"
        android:layout_height="50dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="@color/white"
        android:text="@string/reqHol_confrimBtn"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/selectEnd" />

    <Button
        android:id="@+id/reqHol_homeBtn"
        android:layout_width="125dp"
        android:layout_height="50dp"
        android:layout_marginTop="21dp"
        android:backgroundTint="@color/white"
        android:text="@string/reqHol_homeBtn"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reqHol_confirmBtn" />

    <EditText
        android:id="@+id/selectStart"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginTop="27dp"
        android:background="@color/white"
        android:ems="10"
        android:gravity="center"
        android:hint="@string/select_start_date"
        android:inputType="date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/holidayCalendar" />

    <EditText
        android:id="@+id/selectEnd"
        android:layout_width="202dp"
        android:layout_height="48dp"
        android:layout_marginTop="26dp"
        android:background="@color/white"
        android:ems="10"
        android:gravity="center"
        android:hint="@string/select_end_date"
        android:inputType="date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/selectStart" />


</androidx.constraintlayout.widget.ConstraintLayout>